# KarizTeam Operator — example environment file. PLACEHOLDERS ONLY.
# Never commit real keys. Environment variables are the preferred way to
# supply credentials; the protected local store (chmod 600) is the fallback.

# OpenRouter (https://openrouter.ai) — first-class provider
OPENROUTER_API_KEY="your-openrouter-key-here"

# Direct providers
OPENAI_API_KEY="your-openai-key-here"
ANTHROPIC_API_KEY="your-anthropic-key-here"
GOOGLE_API_KEY="your-google-api-key-here"

# Custom OpenAI-compatible endpoint key (name configurable per profile)
OPENAI_COMPATIBLE_API_KEY="your-endpoint-key-here"

# Override the Operator state directory (config, credentials, sessions, audit)
# OPERATOR_HOME="/custom/path/operator"

# Print stack traces for unexpected errors
# OPERATOR_DEBUG=1
