{
  "name": "@karizteam/operator",
  "version": "0.6.0",
  "description": "ktOperator — a secure, multi-provider AI operating-system agent with an interactive console",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "operator": "dist/cli.js",
    "ktoperator": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "operator",
    "automation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs tests/unit",
    "test:security": "node scripts/run-tests.mjs tests/security",
    "test:integration": "node scripts/run-tests.mjs tests/integration",
    "audit": "npm audit --omit=dev",
    "operator": "node --import tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
